# -----------------------------------------------------------------------------
# OmniGroup HR website — environment variables
# Copy to `.env.local` for `next dev`, or `.dev.vars` for `npm run preview`.
# Never commit real values. Placeholders only.
# -----------------------------------------------------------------------------

# ---- Build-time (public) ---------------------------------------------------
# NEXT_PUBLIC_* values are inlined into the build. Set them in the Cloudflare
# Workers Builds "Build variables" (or your CI) — not as runtime secrets.

# Canonical origin, used for canonical URLs, sitemap, Open Graph and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://www.omnigrouphr.com

# "production" allows indexing. Anything else (e.g. "staging") emits
# noindex metadata and a Disallow-all robots.txt.
NEXT_PUBLIC_SITE_ENV=staging

# Cloudflare Turnstile site key (spam protection widget).
# Test key that always passes: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Analytics (optional, privacy-friendly). Full script URL from Plausible,
# e.g. https://plausible.io/js/pa-XXXXXXXX.js. Leave blank to disable.
NEXT_PUBLIC_PLAUSIBLE_SCRIPT_SRC=

# Cloudflare Web Analytics beacon token (optional, page views only).
NEXT_PUBLIC_CF_BEACON_TOKEN=

# Show the newsletter sign-up only once NEWSLETTER_WEBHOOK_URL is configured.
NEXT_PUBLIC_NEWSLETTER_ENABLED=false

# ---- Runtime secrets (server only) -----------------------------------------
# Set with `npx wrangler secret put NAME` or in the Cloudflare dashboard.

# Turnstile secret key. Test secret that always passes:
# 1x0000000000000000000000000000000AA
TURNSTILE_SECRET_KEY=

# Lead delivery by email via Resend (https://resend.com). The sending domain
# must be verified in Resend.
RESEND_API_KEY=
LEAD_FROM_EMAIL="OmniGroup HR Website <website@omnigrouphr.com>"
# Where employer / VA / staffing enquiries are sent (comma-separate for several).
LEAD_TO_EMAIL=hr@omnigrouphr.com
# Where candidate applications are sent. Falls back to LEAD_TO_EMAIL.
CAREERS_TO_EMAIL=

# Optional: also POST every lead as JSON to a CRM / automation webhook
# (HubSpot, Zapier, Make, etc.).
LEAD_WEBHOOK_URL=

# Newsletter provider webhook (receives {email, source, consentText, submittedAt}).
NEWSLETTER_WEBHOOK_URL=
