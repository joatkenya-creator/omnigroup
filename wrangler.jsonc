{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "omnigroup-hr",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference required by OpenNext; must match "name" above.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "omnigroup-hr"
    }
  ],
  "ratelimits": [
    {
      // Per-IP limit applied to every public form endpoint.
      "name": "FORM_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  // Runtime secrets (RESEND_API_KEY, TURNSTILE_SECRET_KEY, webhook URLs) are
  // set with `wrangler secret put` or the dashboard — never committed here.
  // NEXT_PUBLIC_* values are inlined at build time; see .env.example.
  "observability": { "enabled": true }
}
